# ==============================================================================
# Headwind Remote Control - Local Environment & Build Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to 'secrets.key':
#    cp secrets.key.example secrets.key
# 2. Fill in your server credentials and configuration below.
# 3. Note: 'secrets.key' is in .gitignore and will NEVER be committed to Git.
# ==============================================================================

# SSH Deployment credentials (used by scripts/deploy_webadmin.py)
host=your-mdm-server.example.com
username=root
password=your_ssh_password_here

# Android APK build configuration (used by scripts/build_android_apk.py)
server_remote=https://your-mdm-server.example.com:8089/
secret_remote=your_janus_api_secret_here
versionname=2.4-custom
versioncode=2400

# Optional Keystore Configuration (defaults to generated custom-remote.jks)
# keystore_file=custom-remote.jks
# keystore_password=custom_release_key
# keystore_alias=custom_remote
# keystore_key_password=custom_release_key
